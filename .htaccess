RewriteEngine On

# Redirect /index.html → /
RewriteRule ^index\.html$ / [R=301,L]

# Redirect *.html → clean URL (keep query string)
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Home section clean URLs → serve homepage (URL stays /treatment, /doctors, etc.)
RewriteRule ^(treatment|doctors|testimonials|about-us|faq|contact|book-appointment|visa-travel|how-it-works)/?$ /index.html [L]

# Serve extensionless URLs as .html files
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]
